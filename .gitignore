# sphinx build directories
_build/

# dotfiles
.*
!.gitignore
!.dockerignore
!.gitkeep
!.github
!.githooks
# The template a clone copies to .env — without it `cp .env.example .env`
# (the first step in every guide, including docs/saas-manager-docker.md §2)
# cannot be run at all. `.env` itself stays ignored.
!.env.example
!.mailmap
!.weblate.json
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.zip
*.json
*.log
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/
/venv/Lib
/venv
/config
/custom_addons/theme_liquid_glass
custom_addons/hotel
custom_addons/account_pos_settle_due
custom_addons/base_industry_data
custom_addons/booking_engine
custom_addons/l10n_sa_zatca_compliance
custom_addons/system_config
custom_addons/saas_tenant_guard
check/
odoo-test.log
coverage.xml
custom_addons/saas_manager
custom_addons/library/

# docs/ — keep ignored by default, but force-add specific infrastructure docs:
#   git add -f docs/architecture.md docs/runbooks/db-migration.md


# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!full-infra/
!full-infra/**
full-infra/terraform/.terraform
.terraform/

*.tfstate*
docs/
sphinx_docs/
scripts/srs_docx/
infra - Copy

# v1 snapshot of ./infra, kept as a git-recoverable copy in infra-v1-backup/.
# The blanket `*.json`, `*.log` and `docs/` rules above would otherwise drop
# files from that snapshot, so re-include the tree — but keep the Terraform
# state ignored: it holds live AWS resource attributes and credentials.
!infra-v1-backup/
!infra-v1-backup/**
infra-v1-backup/terraform/*.tfstate*
infra-v1-backup/terraform/.terraform/

# lite-infra / k8s-local: same treatment — treat them as source, not artifacts.
!lite-infra/
!lite-infra/**
!k8s-local/
!k8s-local/**

# Those re-includes are broad on purpose (the manifests and *.tf are source),
# so the artifacts inside them are excluded again here - a later pattern wins.
lite-infra/.terraform/
lite-infra/terraform.tfstate*
lite-infra/terraform.tfvars
lite-infra/*.pem
lite-infra/_tf-mirror.tfrc
lite-infra/_tfinit.log
k8s-local/backups/
