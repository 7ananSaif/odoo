# ============================================================================
# SaaS Manager - environment. Copy to `.env` and fill in the real values.
# NEVER commit `.env`.
# ============================================================================

# --- Manager web app -------------------------------------------------------
# Secret used to sign session cookies (generate with: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=change-me-session-signing-key
# Owner login (single owner). Password is set by scripts/create_owner.py; 2FA is enrolled on first login.
OWNER_EMAIL=owner@example.com
OWNER_NAME=SaaS Owner

# --- Manager database (its own PostgreSQL DB, NOT a client DB) -------------
MANAGER_DB_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/saas_manager

# --- Encryption key for stored secrets (Fernet) ----------------------------
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETS_KEY=change-me-fernet-key

# --- Odoo connection -------------------------------------------------------
# Base URL of one client instance used for provisioning/API calls. The manager
# rewrites the host per tenant subdomain (see ODOO_DOMAIN).
ODOO_BASE_URL=https://app.example.com
ODOO_DOMAIN=example.com
# Master admin password of the Odoo instances (encrypted at rest in the DB, but
# also readable here for bootstrapping). Used for db create/drop/backup.
ODOO_MASTER_PASSWORD=change-me-odoo-master
# The SAME value configured in each client odoo.conf as `saas_manager_token`.
ODOO_MANAGER_TOKEN=change-me-manager-token

# --- Filesystem / binaries -------------------------------------------------
# Odoo source root (contains odoo-bin / odoo-bin.py) and the python executable
# used to run it. On Windows use the venv python that has Odoo's deps.
ODOO_BIN=C:\odoo\odoo\odoo-bin
ODOO_PYTHON=C:\odoo\odoo\venv\Scripts\python.exe
ODOO_DATA_DIR=C:\odoo\data
# PostgreSQL client tools
PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
PG_RESTORE=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
PG_PSQL=C:\Program Files\PostgreSQL\17\bin\psql.exe
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=odoo
PG_PASSWORD=change-me-pg-password
# Where tenant backups are written
BACKUP_DIR=C:\saas_backups

# --- Workers (Celery + Redis) ----------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Bounded parallelism for update/backup jobs
UPDATE_MAX_PARALLEL=2
SCHEDULER_ENABLED=true

# --- Apps page (start / stop / restart the stack's containers) --------------
# The panel talks to the Docker daemon itself over this socket. A normal Linux
# install already has it at the default; on Docker Desktop point it at the
# exposed socket. When the path does not exist the Apps page explains how to
# enable it instead of showing controls.
DOCKER_SOCKET=/var/run/docker.sock
# Only containers belonging to this compose project are controllable. LEAVE
# EMPTY for a bare-metal run, which makes the panel accept any project.
COMPOSE_PROJECT=
# Compose services the panel may start / stop / restart. The database, Redis,
# RabbitMQ, certbot and the manager's own services are refused in code whatever
# this list says. Empty here means the Apps page controls nothing.
APP_SERVICES=odoo,odoo-control,worker,invoice-ai,nginx

# --- Behaviour -------------------------------------------------------------
# Suspend tenants automatically after this many days past an unpaid invoice due date
GRACE_DAYS=7
# Default trial length for new tenants
TRIAL_DAYS=14
# Currency + tax defaults for new plans/invoices
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0.0
# Rate limiting (slowapi)
RATE_LIMIT_LOGIN=10/minute

# --- Outgoing email (invoice sending + dunning reminders) ------------------
# Set EMAIL_ENABLED=true and fill in the SMTP settings to send invoice PDFs
# and dunning reminders. When disabled, the manager records the action in the
# audit log and skips the actual send (nothing breaks).
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=billing@example.com
SMTP_PASSWORD=change-me-smtp-password
# STARTTLS (usually 587). Set SMTP_USE_SSL=true instead for implicit TLS (465).
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=billing@example.com
EMAIL_FROM_NAME=SaaS Manager Billing
EMAIL_TIMEOUT=20
